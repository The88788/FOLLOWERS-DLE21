<div class="blog-list-box border-gradient-info mb-30">

<div class="blog-head" style="overflow:hidden;max-height:250px"><a href="{full-link}"><img src="[xfgiven_poster][xfvalue_image_url_poster][/xfgiven_poster][xfnotgiven_poster]{image-1}[/xfnotgiven_poster]" alt="" loading="lazy" decoding="async"></a></div>

<div class="blog-content">

<div class="blog-content-head">
<div class="row">

<div class="col-sm-7">
<div class="blog-content-cate">
<ul class="list-inline">
<li class="list-inline-item"><span class="btn-gradient-cate-info">{category}</span></li>
</ul>
</div></div>

<div class="col-sm-5">
<div class="blog-content-date"><p><i class="mdi mdi-clock"></i> {date}</p></div>
</div>

</div></div>

<div class="blog-content-body">
<h2 class="blog-title mb-20"><a href="{full-link}">{title}</a></h2>
<p class="blog-desc mb-30">{short-story limit="250"}</p>
</div>

</div>

<div class="blog-footer">
<div class="row">
<div class="col-sm-4"><p class="mb-0 blog-author"><span class="text-dim"><i class="mdi mdi-account"></i> Автор : </span>{author}</p></div>
<div class="col-sm-4"><p class="mb-0 blog-views"><span class="text-dim"><i class="mdi mdi-eye"></i> Смотрели : </span>{views}</p></div>
<div class="col-sm-4"><p class="mb-0 blog-comment"><span class="text-dim"><i class="mdi mdi-comment-processing"></i> Мнений : </span>{comments-num}</p></div>
</div></div>

</div>
