<div class="comment odd depth-1">
<div class="comment-wrap">
<div class="media">
<img alt="{login}" src="{foto}" class="mr-3" height="72" width="72">
<div class="media-body">
<h4 class="media-heading">{author}</h4>
<p class="post-date"><i class="mdi mdi-calendar"></i> {date}</p>
<div class="text-comment">{comment}</div>
<div class="comment-actions">[reply]Ответить[/reply] [com-edit]Редактировать[/com-edit] [com-del]Удалить[/com-del]</div>
</div>
</div>
</div>
</div>
